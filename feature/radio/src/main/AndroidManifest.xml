<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet radio streaming. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground media service that keeps radio playing and shows the notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Audio focus and the tuner's mute use the normal audio APIs. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
        The hardware FM tuner needs android.permission.ACCESS_BROADCAST_RADIO, a system-only permission
        that Play-installed apps are never granted, so it is deliberately NOT declared (it only caused
        store/lint warnings). The Radio screen already shows "hardware unavailable" without it.
        Add it back only for a privileged / custom-ROM build.
    -->

    <!-- FM hardware is optional: the app must still install on phones without it. -->
    <uses-feature android:name="android.hardware.broadcastradio" android:required="false" />

    <application>
        <service
            android:name=".service.RadioPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>
