<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.VIBRATE"/>

    <application
        android:name=".application.MelodiQApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MelodiQ"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MelodiQ">
        </activity>

        <!-- One launcher entry per selectable icon (Settings > App icon). Exactly one is enabled
             at a time; main_1 is the default. -->
        <activity-alias
            android:name="com.tasnimulhasan.melodiq.alias.LogoMain1"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_alias_main_1"
            android:roundIcon="@mipmap/ic_alias_main_1"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.tasnimulhasan.melodiq.alias.LogoMain2"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_alias_main_2"
            android:roundIcon="@mipmap/ic_alias_main_2"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.tasnimulhasan.melodiq.alias.LogoMain3"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_alias_main_3"
            android:roundIcon="@mipmap/ic_alias_main_3"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.tasnimulhasan.melodiq.alias.LogoMain4"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_alias_main_4"
            android:roundIcon="@mipmap/ic_alias_main_4"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.tasnimulhasan.melodiq.alias.LogoAlt1"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_alias_alt_1"
            android:roundIcon="@mipmap/ic_alias_alt_1"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.tasnimulhasan.melodiq.alias.LogoAlt2"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_alias_alt_2"
            android:roundIcon="@mipmap/ic_alias_alt_2"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.tasnimulhasan.melodiq.alias.LogoAlt3"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_alias_alt_3"
            android:roundIcon="@mipmap/ic_alias_alt_3"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.tasnimulhasan.melodiq.alias.LogoAlt4"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_alias_alt_4"
            android:roundIcon="@mipmap/ic_alias_alt_4"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Home screen widgets (Glance). Both read the same player state; see widget/ package. -->
        <receiver
            android:name=".widget.MelodiqPlayerWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_player_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/melodiq_widget_player_info" />
        </receiver>

        <receiver
            android:name=".widget.MelodiqCompactWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_compact_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/melodiq_widget_compact_info" />
        </receiver>

        <receiver
            android:name=".widget.MelodiqCoverWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_cover_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/melodiq_widget_cover_info" />
        </receiver>

        <receiver
            android:name=".widget.MelodiqRecentWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_recent_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/melodiq_widget_recent_info" />
        </receiver>

        <receiver
            android:name=".widget.MelodiqFavouritesWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_favourites_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/melodiq_widget_favourites_info" />
        </receiver>

        <receiver
            android:name=".widget.MelodiqIpodDarkWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_ipod_dark_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/melodiq_widget_ipod_dark_info" />
        </receiver>

        <receiver
            android:name=".widget.MelodiqIpodSilverWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_ipod_silver_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/melodiq_widget_ipod_silver_info" />
        </receiver>

        <service
            android:name="com.tasnimulhasan.data.player.MelodiqPlayerService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>

</manifest>